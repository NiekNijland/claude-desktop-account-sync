#!/usr/bin/env python3
"""Keep the Claude desktop app's Code sessions (and optionally scheduled tasks)
in step between several accounts on one Mac.

The app stores sidebar metadata per account:
  ~/Library/Application Support/Claude/claude-code-sessions/<account>/<org>/
Accounts that belong to the same organisation get the same <org> folder name,
so this tool syncs those folders with each other. Transcripts live outside
that folder (~/.claude/projects) and are already shared.

This uses an undocumented on-disk format and may break after an app update.
"""
import argparse
import json
import os
import plistlib
import shutil
import subprocess
import sys
from pathlib import Path

DEFAULT_ROOT = Path.home() / "Library/Application Support/Claude/claude-code-sessions"
LABEL = "io.github.claude-account-sync"
INSTALLED_BIN = Path.home() / ".local/bin/claude-account-sync"
AGENT_PLIST = Path.home() / "Library/LaunchAgents" / f"{LABEL}.plist"
LOG_FILE = Path.home() / "Library/Logs/claude-account-sync.log"
SCHEDULES = "scheduled-tasks.json"


class Syncer:
    def __init__(self, root, dry_run, verbose, schedules, union):
        self.root = root
        self.trash = root.parent / "claude-code-sessions-sync-trash"
        self.dry_run = dry_run
        self.verbose = verbose or dry_run
        self.schedules = schedules or union
        self.union = union

    def log(self, msg):
        if self.verbose:
            print(("[dry-run] " if self.dry_run else "") + msg)

    def org_dirs(self):
        groups = {}
        for account in sorted(self.root.iterdir()):
            if not account.is_dir() or account.is_symlink():
                continue
            for org in sorted(account.iterdir()):
                if org.is_dir() and not org.is_symlink():
                    groups.setdefault(org.name, []).append(org)
        return {name: dirs for name, dirs in groups.items() if len(dirs) > 1}

    def short(self, d):
        return d.parent.name[:8]

    def write_atomic(self, dst, data):
        tmp = dst.with_name(f".{dst.name}.sync-tmp")
        tmp.write_bytes(data)
        os.replace(tmp, dst)

    def copy_file(self, src, dst):
        self.log(f"copy {src.name} -> {self.short(dst.parent)}")
        if self.dry_run:
            return
        tmp = dst.with_name(f".{dst.name}.sync-tmp")
        shutil.copy2(src, tmp)
        os.replace(tmp, dst)

    def to_trash(self, path, label):
        self.log(f"trash {label}")
        if self.dry_run:
            return
        self.trash.mkdir(exist_ok=True)
        shutil.move(path, self.trash / label)

    def sync_sessions(self, dirs):
        deleted = set()
        for d in dirs:
            deleted |= {p.name[len("deleted_"):] for p in d.glob("deleted_*")}

        for d in dirs:
            for sid in deleted:
                marker = d / f"deleted_{sid}"
                if not marker.exists():
                    src = next(x / marker.name for x in dirs if (x / marker.name).exists())
                    self.copy_file(src, marker)
                meta = d / f"local_{sid}.json"
                if meta.exists():
                    self.to_trash(meta, f"{d.parent.name}_{meta.name}")

        names = {p.name for d in dirs for p in d.glob("local_*.json") if p.name[len("local_"):-len(".json")] not in deleted}
        for name in names:
            present = [d / name for d in dirs if (d / name).exists()]
            newest = max(present, key=lambda p: p.stat().st_mtime)
            for d in dirs:
                target = d / name
                if not target.exists() or target.stat().st_mtime < newest.stat().st_mtime - 1:
                    self.copy_file(newest, target)

    def union_schedules(self, files):
        docs = [json.loads(f.read_text()) for f in files]
        merged = {}
        for doc in docs:
            for task in doc.get("scheduledTasks", []):
                current = merged.get(task["id"])
                if current is None or task.get("lastRunAt", "") > current.get("lastRunAt", ""):
                    merged[task["id"]] = task
        base = dict(docs[0])
        base["scheduledTasks"] = sorted(merged.values(), key=lambda t: t.get("createdAt", 0))
        return (json.dumps(base, indent=2) + "\n").encode()

    def sync_schedules(self, dirs):
        files = [d / SCHEDULES for d in dirs if (d / SCHEDULES).exists()]
        if not files:
            return
        if self.union:
            data, label = self.union_schedules(files), "union"
        else:
            newest = max(files, key=lambda p: p.stat().st_mtime)
            data, label = newest.read_bytes(), f"newest ({self.short(newest.parent)})"
        for d in dirs:
            target = d / SCHEDULES
            if target.exists() and target.read_bytes() == data:
                continue
            self.log(f"schedules {label} -> {self.short(target.parent)}")
            if self.dry_run:
                continue
            if target.exists():
                self.trash.mkdir(exist_ok=True)
                backup = f"{target.parent.parent.name}_{int(target.stat().st_mtime)}_{SCHEDULES}"
                shutil.copy2(target, self.trash / backup)
            self.write_atomic(target, data)

    def run(self):
        if not self.root.is_dir():
            sys.exit(f"{self.root} not found. Is the Claude desktop app installed?")
        for dirs in self.org_dirs().values():
            self.sync_sessions(dirs)
            if self.schedules:
                self.sync_schedules(dirs)


def launchctl(*args):
    return subprocess.run(["launchctl", *args], capture_output=True, text=True)


def install(root, schedules):
    INSTALLED_BIN.parent.mkdir(parents=True, exist_ok=True)
    shutil.copy2(Path(__file__).resolve(), INSTALLED_BIN)
    INSTALLED_BIN.chmod(0o755)

    watch = sorted(str(d) for dirs in Syncer(root, False, False, False, False).org_dirs().values() for d in dirs)
    args = ["/usr/bin/python3", str(INSTALLED_BIN), "--root", str(root)]
    if schedules:
        args.append("--schedules")
    plist = {
        "Label": LABEL,
        "ProgramArguments": args,
        "WatchPaths": watch,
        "StartInterval": 120,
        "RunAtLoad": True,
        "ThrottleInterval": 10,
        "StandardErrorPath": str(LOG_FILE),
    }
    AGENT_PLIST.parent.mkdir(parents=True, exist_ok=True)
    with open(AGENT_PLIST, "wb") as f:
        plistlib.dump(plist, f)
    domain = f"gui/{os.getuid()}"
    launchctl("bootout", f"{domain}/{LABEL}")
    result = launchctl("bootstrap", domain, str(AGENT_PLIST))
    if result.returncode != 0:
        sys.exit(f"launchctl bootstrap failed: {result.stderr.strip()}")
    print(f"Installed {AGENT_PLIST} watching {len(watch)} folders. Re-run install after adding an account.")


def uninstall():
    launchctl("bootout", f"gui/{os.getuid()}/{LABEL}")
    AGENT_PLIST.unlink(missing_ok=True)
    INSTALLED_BIN.unlink(missing_ok=True)
    print("Removed the launch agent and the installed script.")


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("command", nargs="?", choices=["sync", "install", "uninstall"], default="sync")
    parser.add_argument("-n", "--dry-run", action="store_true", help="only print what would change")
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("--schedules", action="store_true", help="also sync scheduled-tasks.json (newest file wins)")
    parser.add_argument("--union", action="store_true", help="merge scheduled tasks by id instead; use once to combine diverged lists (implies --schedules)")
    parser.add_argument("--root", type=Path, default=Path(os.environ.get("CLAUDE_SESSIONS_ROOT", DEFAULT_ROOT)))
    args = parser.parse_args()

    if args.command == "install":
        install(args.root, args.schedules or args.union)
    elif args.command == "uninstall":
        uninstall()
    else:
        Syncer(args.root, args.dry_run, args.verbose, args.schedules, args.union).run()


if __name__ == "__main__":
    main()
