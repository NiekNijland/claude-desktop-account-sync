#!/usr/bin/env python3
"""Keep the Claude desktop app's Code sessions (and optionally scheduled tasks)
in step between several accounts on one Mac.

The app stores sidebar metadata per account:
  ~/Library/Application Support/Claude/claude-code-sessions/<account>/<org>/
Accounts that belong to the same organisation get the same <org> folder name,
so this tool syncs those folders with each other. Transcripts live outside
that folder (~/.claude/projects) and are already shared.

This uses an undocumented on-disk format and may break after an app update.
"""
import argparse
import contextlib
import fcntl
import io
import json
import os
import plistlib
import shutil
import subprocess
import sys
import time
from datetime import datetime
from pathlib import Path

DEFAULT_ROOT = Path.home() / "Library/Application Support/Claude/claude-code-sessions"
VERSION = "0.1.0"
LABEL = "io.github.claude-account-sync"
INSTALLED_BIN = Path.home() / ".local/bin/claude-account-sync"
AGENT_PLIST = Path.home() / "Library/LaunchAgents" / f"{LABEL}.plist"
LOG_FILE = Path.home() / "Library/Logs/claude-account-sync.log"
AGENT_PATH = "/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"
SCHEDULES = "scheduled-tasks.json"
RECENT_SECONDS = 2
TRASH_DAYS = 30
MAX_LOG_BYTES = 1_000_000


def say(msg):
    print(msg, flush=True)


def warn(msg):
    print(msg, file=sys.stderr, flush=True)


def org_dirs(root):
    groups = {}
    for account in sorted(root.iterdir()):
        if not account.is_dir() or account.is_symlink():
            continue
        for org in sorted(account.iterdir()):
            if org.is_dir() and not org.is_symlink():
                groups.setdefault(org.name, []).append(org)
    return {name: dirs for name, dirs in groups.items() if len(dirs) > 1}


def read_json(path):
    try:
        doc = json.loads(path.read_text())
    except (OSError, ValueError) as error:
        warn(f"skipping {path}: {error}")
        return None
    if not isinstance(doc, dict):
        warn(f"skipping {path}: not a JSON object")
        return None
    return doc


def tasks_of(doc):
    tasks = doc.get("scheduledTasks")
    return [t for t in tasks if isinstance(t, dict) and "id" in t] if isinstance(tasks, list) else []


def last_run(task):
    value = task.get("lastRunAt")
    if isinstance(value, (int, float)):
        return value / 1000 if value > 1e11 else value
    if isinstance(value, str):
        try:
            return datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
        except ValueError:
            pass
    return 0


class Syncer:
    def __init__(self, root, dry_run=False, verbose=False, schedules=False, union=False):
        self.root = root
        self.trash = root.parent / "claude-code-sessions-sync-trash"
        self.dry_run = dry_run
        self.verbose = verbose
        self.schedules = schedules or union
        self.union = union

    def act(self, msg):
        say(("[dry-run] " if self.dry_run else "") + msg)

    def is_recent(self, path):
        return time.time() - path.stat().st_mtime < RECENT_SECONDS

    def put(self, dst, data, mtime):
        if self.dry_run:
            return
        tmp = dst.with_name(f".{dst.name}.{os.getpid()}.tmp")
        try:
            tmp.write_bytes(data)
            os.utime(tmp, (mtime, mtime))
            os.replace(tmp, dst)
        finally:
            tmp.unlink(missing_ok=True)

    def backup(self, path):
        if self.dry_run:
            return
        self.trash.mkdir(exist_ok=True)
        shutil.copyfile(path, self.trash / f"{time.time_ns()}_{path.parent.parent.name}_{path.name}")

    def overwrite(self, dst, data, mtime, keep_old=False):
        self.act(f"write {dst.name} in {dst.parent.parent.name[:8]}")
        if keep_old and dst.exists():
            self.backup(dst)
        self.put(dst, data, mtime)

    def trash_file(self, path):
        self.act(f"trash {path.name} in {path.parent.parent.name[:8]}")
        self.backup(path)
        if not self.dry_run:
            path.unlink()

    def prune_trash(self):
        if self.dry_run or not self.trash.is_dir():
            return
        cutoff = time.time() - TRASH_DAYS * 86400
        for entry in self.trash.iterdir():
            if entry.is_file() and entry.stat().st_mtime < cutoff:
                entry.unlink(missing_ok=True)

    def sync_sessions(self, dirs):
        markers = {p.name[len("deleted_"):]: p for d in dirs for p in d.glob("deleted_*")}
        for d in dirs:
            for sid, source in markers.items():
                marker = d / f"deleted_{sid}"
                if not marker.exists():
                    self.overwrite(marker, source.read_bytes(), source.stat().st_mtime)
                if (d / f"local_{sid}.json").exists():
                    self.trash_file(d / f"local_{sid}.json")

        deleted_names = {f"local_{sid}.json" for sid in markers}
        for name in {p.name for d in dirs for p in d.glob("local_*.json")} - deleted_names:
            newest = max((d / name for d in dirs if (d / name).exists()), key=lambda p: p.stat().st_mtime)
            if self.is_recent(newest) or read_json(newest) is None:
                continue
            data, mtime = newest.read_bytes(), newest.stat().st_mtime
            for d in dirs:
                if not (d / name).exists() or (d / name).read_bytes() != data:
                    self.overwrite(d / name, data, mtime)

    def merged_tasks(self, docs_newest_first):
        merged = {}
        for doc in docs_newest_first:
            for task in tasks_of(doc):
                current = merged.get(task["id"])
                if current is None or last_run(task) > last_run(current):
                    merged[task["id"]] = task
        return sorted(merged.values(), key=lambda t: t["createdAt"] if isinstance(t.get("createdAt"), (int, float)) else 0)

    def sync_schedules(self, dirs):
        existing = [d / SCHEDULES for d in dirs if (d / SCHEDULES).exists()]
        if not existing or any(self.is_recent(p) for p in existing):
            return
        docs = {p: doc for p in existing if (doc := read_json(p)) is not None}
        if not docs:
            return
        by_age = sorted(docs, key=lambda p: p.stat().st_mtime, reverse=True)

        if self.union:
            base = dict(docs[by_age[0]])
            base["scheduledTasks"] = self.merged_tasks([docs[p] for p in by_age])
            data, mtime = (json.dumps(base, indent=2) + "\n").encode(), by_age[0].stat().st_mtime
        else:
            source = by_age[0]
            if not tasks_of(docs[source]):
                populated = [p for p in by_age if tasks_of(docs[p])]
                if populated:
                    warn(f"{SCHEDULES} in {source.parent.parent.name[:8]} is empty; not letting it overwrite the others")
                    source = populated[0]
            data, mtime = source.read_bytes(), source.stat().st_mtime

        for d in dirs:
            target = d / SCHEDULES
            if not target.exists() or target.read_bytes() != data:
                self.overwrite(target, data, mtime, keep_old=True)

    def run(self):
        if not self.root.is_dir():
            sys.exit(f"{self.root} not found. Is the Claude desktop app installed?")
        if not self.dry_run:
            lock = open(self.root.parent / ".claude-account-sync.lock", "w")
            try:
                fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
            except BlockingIOError:
                sys.exit("Another sync is already running.")
        groups = org_dirs(self.root)
        if not groups and (self.verbose or self.dry_run):
            say("No organisation is shared by two accounts; nothing to sync.")
        for dirs in groups.values():
            try:
                self.sync_sessions(dirs)
                if self.schedules:
                    self.sync_schedules(dirs)
            except OSError as error:
                warn(f"skipping a round: {error}")
        self.prune_trash()


def rotate_log():
    try:
        if LOG_FILE.stat().st_size > MAX_LOG_BYTES:
            LOG_FILE.write_text("")
    except FileNotFoundError:
        pass


def launchctl(*args):
    return subprocess.run(["launchctl", *args], capture_output=True, text=True)


def install(root, schedules, dry_run):
    args = [str(INSTALLED_BIN), "--root", str(root)] + (["--schedules"] if schedules else [])
    plist = {
        "Label": LABEL,
        "ProgramArguments": args,
        "EnvironmentVariables": {"PATH": AGENT_PATH},
        "StartInterval": 60,
        "RunAtLoad": True,
        "StandardOutPath": str(LOG_FILE),
        "StandardErrorPath": str(LOG_FILE),
    }
    if dry_run:
        say(f"[dry-run] would install {INSTALLED_BIN} and {AGENT_PLIST}:\n{json.dumps(plist, indent=2)}")
        return
    INSTALLED_BIN.parent.mkdir(parents=True, exist_ok=True)
    if Path(__file__).resolve() != INSTALLED_BIN.resolve():
        shutil.copy2(Path(__file__).resolve(), INSTALLED_BIN)
    INSTALLED_BIN.chmod(0o755)
    AGENT_PLIST.parent.mkdir(parents=True, exist_ok=True)
    with open(AGENT_PLIST, "wb") as f:
        plistlib.dump(plist, f)
    domain = f"gui/{os.getuid()}"
    launchctl("bootout", f"{domain}/{LABEL}")
    result = launchctl("bootstrap", domain, str(AGENT_PLIST))
    if result.returncode != 0:
        time.sleep(1)
        result = launchctl("bootstrap", domain, str(AGENT_PLIST))
    if result.returncode != 0:
        sys.exit(f"launchctl bootstrap failed: {result.stderr.strip()}")
    say(f"Installed {AGENT_PLIST}; it syncs every minute.")


def uninstall(dry_run):
    if dry_run:
        say(f"[dry-run] would remove {AGENT_PLIST} and {INSTALLED_BIN}")
        return
    launchctl("bootout", f"gui/{os.getuid()}/{LABEL}")
    AGENT_PLIST.unlink(missing_ok=True)
    INSTALLED_BIN.unlink(missing_ok=True)
    say(f"Removed the launch agent and the installed script. The log ({LOG_FILE}) and the trash folder stay.")


def ask(question, default=True, assume_yes=False):
    if assume_yes:
        return default
    if not sys.stdin.isatty():
        sys.exit("Not an interactive terminal; pass --yes to accept the defaults.")
    answer = input(f"{question} [{'Y/n' if default else 'y/N'}] ").strip().lower()
    return default if not answer else answer.startswith("y")


def schedule_ids(dirs):
    result = {}
    for d in dirs:
        doc = read_json(d / SCHEDULES) if (d / SCHEDULES).exists() else None
        if doc is not None:
            result[d.parent.name] = {t["id"] for t in tasks_of(doc)}
    return result


def check(root):
    """Describe what a sync would do. Returns (groups, task lists differ?)."""
    if not root.is_dir():
        sys.exit(f"{root} not found. Is the Claude desktop app installed and signed in?")
    groups = org_dirs(root)
    if not groups:
        sys.exit("No organisation is shared by two accounts yet. Sign in with both accounts in the "
                 "Claude desktop app (and open the Code tab once each), then try again.")
    differ = False
    for org, dirs in groups.items():
        say(f"Organisation {org[:8]}, {len(dirs)} accounts:")
        for d in dirs:
            say(f"  {d.parent.name[:8]}: {len(list(d.glob('local_*.json')))} sessions")
        ids = schedule_ids(dirs)
        if ids:
            differ = differ or len({frozenset(v) for v in ids.values()}) > 1
            for account, names in ids.items():
                say(f"  {account[:8]}: {len(names)} scheduled tasks")
    pending = io.StringIO()
    with contextlib.redirect_stdout(pending):
        Syncer(root, dry_run=True, schedules=True).run()
    say(f"A sync would change {len(pending.getvalue().splitlines())} files right now.")
    if differ:
        say("The accounts have different scheduled tasks.")
    return groups, differ


def guided_install(root, schedules, assume_yes):
    groups, differ = check(root)
    has_schedules = any(schedule_ids(dirs) for dirs in groups.values())
    schedules = schedules or (has_schedules and ask("Also keep scheduled tasks in sync?", assume_yes=assume_yes))
    if schedules and differ and ask("Merge the task lists into one now? Nothing is lost; originals go to the trash folder.", assume_yes=assume_yes):
        Syncer(root, union=True).run()
    if not ask("Install the launch agent (syncs every minute)?", assume_yes=assume_yes):
        return
    install(root, schedules, dry_run=False)


def main():
    parser = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    parser.add_argument("command", nargs="?", choices=["sync", "check", "install", "uninstall"], default="sync")
    parser.add_argument("-n", "--dry-run", action="store_true", help="only print what would change")
    parser.add_argument("-v", "--verbose", action="store_true")
    parser.add_argument("--schedules", action="store_true", help="also sync scheduled-tasks.json (newest file wins)")
    parser.add_argument("--union", action="store_true", help="merge scheduled tasks by id once; implies --schedules, not for install")
    parser.add_argument("--yes", action="store_true", help="install: accept the defaults without asking")
    parser.add_argument("--version", action="version", version=VERSION)
    parser.add_argument("--root", type=Path, default=Path(os.environ.get("CLAUDE_SESSIONS_ROOT", DEFAULT_ROOT)))
    args = parser.parse_args()

    if args.command != "sync" and args.union:
        parser.error("--union is a one-off merge; run it with 'sync', then install with --schedules")
    if args.command == "check":
        check(args.root)
    elif args.command == "install" and args.dry_run:
        install(args.root, args.schedules, dry_run=True)
    elif args.command == "install":
        guided_install(args.root, args.schedules, args.yes)
    elif args.command == "uninstall":
        uninstall(args.dry_run)
    else:
        if not args.dry_run:
            rotate_log()
        Syncer(args.root, args.dry_run, args.verbose, args.schedules, args.union).run()


if __name__ == "__main__":
    main()
